---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Psalm of the Day">
  <p class="loading-text">Loading today's Psalm…</p>
  <script define:vars={{ base: import.meta.env.BASE_URL }}>
    const now = new Date();
    const start = new Date(now.getFullYear(), 0, 1);
    const dayOfYear = Math.ceil((now - start) / 86400000) + 1;
    const n = ((dayOfYear - 1) % 150) + 1;

    const translation = localStorage.getItem('favored-translation') || 'web';
    const pathMap = {
      web: `/psalms/${n}`,
      kjv: `/psalms/kjv/${n}`,
      es:  `/psalms/es/${n}`,
      it:  `/psalms/it/${n}`,
      pl:  `/psalms/pl/${n}`,
      pt:  `/psalms/pt/${n}`,
    };
    const psalmPath = pathMap[translation] ?? `/psalms/${n}`;
    const psalmUrl = base.replace(/\/$/, '') + psalmPath;

    fetch(psalmUrl)
      .then(r => r.text())
      .then(html => {
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const article = doc.querySelector('article');
        if (article) {
          document.querySelector('.loading-text').replaceWith(article);
          document.title = doc.title;
          window.__psalmLoaded = true;
          document.dispatchEvent(new CustomEvent('psalm-loaded'));
        } else {
          window.location.replace(psalmUrl);
        }
      })
      .catch(() => window.location.replace(psalmUrl));
  </script>
  <script>
    import { setupTranslationSwitcher } from '../scripts/translationSwitcher';
    // The article is injected asynchronously above. This module may load either
    // before or after that happens, so handle both orderings rather than relying
    // on catching the one-shot event in time.
    if (window.__psalmLoaded) setupTranslationSwitcher();
    else document.addEventListener('psalm-loaded', () => setupTranslationSwitcher(), { once: true });
  </script>
  <noscript>
    <p>Enable JavaScript to see today's Psalm, or <a href="psalms/">browse all 150 Psalms</a>.</p>
  </noscript>
</BaseLayout>
